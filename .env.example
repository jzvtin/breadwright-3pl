# Copy to .env (local) or set these as Railway variables. NEVER commit real values.

# Dry-run: 1 = never touch SFTP, write XML to out/ instead. Great for testing.
DRY_RUN=1

# --- Datex / Ice Cube SFTP (from the 3PL) ---
DATEX_SFTP_HOST=datexsftp.footprintwms.com
DATEX_SFTP_PORT=22
DATEX_SFTP_USER=datexsftp.icssftpadmin
# ROTATE THIS with the 3PL — it was shared in plaintext over email.
DATEX_SFTP_PASSWORD=
# CONFIRM these folder names with Bill:
DATEX_SFTP_OUTBOUND_DIR=/inbound
DATEX_SFTP_RETURN_DIR=/outbound
DATEX_SFTP_ARCHIVE_DIR=/outbound/processed

# --- Shopify ---
SHOPIFY_STORE=breadwright-3.myshopify.com
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_ADMIN_TOKEN=

PORT=3000

# Yahuda Priority Shippers / Shipping-Intelligent API bearer token (Admin > API Integrations)
PRIORITYSHIPPERS_TOKEN=PASTE_PRIORITYSHIPPERS_TOKEN
